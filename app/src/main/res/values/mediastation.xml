<resources>
<color name="item_bg_selected">#303030</color>
<integer name="weight_bold">700</integer>
<dimen name="tv_dialog_width">580dp</dimen>
<color name="tv_dialog_border">#503498DA</color>
<color name="tv_accent">#3498DA</color>
<dimen name="normal_card_thumb_padding">1dp</dimen>
<color name="tv_dialog_action_focused">#383498DA</color>
<color name="transparent">#00FFFFFF</color>
<color name="default_text_light">@color/white</color>
<style name="LeanbackDialog" parent="android:Theme.Material.Dialog">
		<item name="android:windowBackground">@drawable/dialog_rounded_corners</item>
		<item name="android:fontFamily">@font/theme</item>
	</style>
<color name="tv_dialog_panel">#F2181D20</color>
<style name="MovieDetailsAction">
		<item name="android:layout_height">match_parent</item>
		<item name="android:clickable">true</item>
		<item name="android:focusable">true</item>
		<item name="android:focusableInTouchMode">true</item>
		<item name="android:gravity">center</item>
		<item name="android:orientation">horizontal</item>
		<item name="android:paddingLeft">14dp</item>
		<item name="android:paddingRight">14dp</item>
	</style>
<style name="MovieDetailsMetaSeparator" parent="MovieDetailsMetaText">
		<item name="android:layout_marginLeft">8dp</item>
		<item name="android:layout_marginRight">8dp</item>
		<item name="android:textColor">#78FFFFFF</item>
	</style>
<color name="player_text">@color/lb_tv_white</color>
<string name="details_action_watch_1">Watch</string>
<color name="item_bg_normal">#161616</color>
<style name="MovieDetailsMetaText">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:fontFamily">@font/theme</item>
		<item name="android:textColor">#D8FFFFFF</item>
		<item name="android:textSize">14sp</item>
	</style>
<color name="lb_tv_white">#FFCCCCCC</color>
<color name="menu_button_bg_selected">#1AFFFFFF</color>
<dimen name="tv_dialog_action_height">50dp</dimen>
<dimen name="playback_title_size">24sp</dimen>
<color name="browser_focus">#3498DA</color>
<dimen name="card_video_width">@dimen/large_card_width</dimen>
<dimen name="card_video_thumb_height">@dimen/large_card_thumb_height</dimen>
<color name="tv_dialog_accent">@color/tv_accent</color>
<color name="tv_dialog_action_selected">#283498DA</color>
<color name="playback_progress_color">@color/tv_accent</color>
<style name="MovieDetailsActionLabel">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginLeft">8dp</item>
		<item name="android:fontFamily">@font/theme</item>
		<item name="android:textAllCaps">true</item>
		<item name="android:textColor">@android:color/white</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textSize">10sp</item>
	</style>
<color name="player_overlay">#CC000000</color>
<color name="tv_dialog_text_secondary">#B8FFFFFF</color>
<style name="NormalCardItemTitle">
		<item name="android:fontFamily">@font/theme</item>
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">60dp</item>
		<item name="android:padding">@dimen/normal_card_title_padding</item>
		<item name="android:lines">@integer/normal_card_title_lines</item>
		<item name="android:maxLines">@integer/normal_card_title_lines</item>
		<item name="android:textSize">@dimen/normal_card_title_size_max</item>
		<item name="android:textColor">@color/item_card_text</item>
		<item name="android:duplicateParentState">true</item>
		<item name="android:background">@drawable/item_card_bg_selector</item>
		<item name="android:ellipsize">end</item>
	</style>
<dimen name="card_video_margin">@dimen/large_card_vertical_margin</dimen>
<dimen name="card_video_thumb_width">@dimen/card_video_width</dimen>
<dimen name="large_card_width">105dp</dimen>
<color name="white">#FFFFFF</color>
<integer name="normal_card_title_lines">3</integer>
<dimen name="normal_card_title_padding">8dp</dimen>
<dimen name="normal_card_title_size_max">13sp</dimen>
<dimen name="large_card_thumb_height">120dp</dimen>
<dimen name="large_card_vertical_margin">10dp</dimen>
<dimen name="item_border_size">2dp</dimen>
<color name="item_fg_selected">@color/default_text_light</color>
<color name="item_fg_normal">#707070</color>
<dimen name="card_large_width">275dp</dimen>
<dimen name="card_large_height">80dp</dimen>
<color name="item_bg_border">@color/item_bg_selected</color>
<dimen name="tv_dialog_animation_offset">40dp</dimen>
<dimen name="tv_dialog_action_spacing">5dp</dimen>
<dimen name="tv_dialog_actions_max_height">360dp</dimen>
<dimen name="tv_dialog_message_max_height">280dp</dimen>
<dimen name="tv_dialog_message_scroll_step">76dp</dimen>
<color name="browser_header_background">#F207111D</color>
<string name="browser_search">Search music</string>
</resources>
