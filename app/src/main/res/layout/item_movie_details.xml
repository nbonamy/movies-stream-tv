<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:ignore="RtlHardcoded">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/movie_details_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingLeft="50dp"
        android:paddingTop="46dp"
        android:paddingRight="44dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/movie_poster"
            android:layout_width="248dp"
            android:layout_height="376dp"
            android:layout_marginRight="44dp"
            android:background="@drawable/movie_poster_background"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:elevation="12dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/item_video" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/movie_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/theme"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textFontWeight="@integer/weight_bold"
                android:textSize="30sp"
                tools:text="Dune - Première partie" />

            <TextView
                android:id="@+id/movie_tagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/theme"
                android:maxLines="1"
                android:textColor="#B8FFFFFF"
                android:textSize="16sp"
                tools:text="Au-delà de la peur, le destin attend." />

            <LinearLayout
                android:id="@+id/movie_meta"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/movie_year"
                    style="@style/MovieDetailsMetaText"
                    tools:text="2021" />

                <TextView
                    android:id="@+id/movie_year_separator"
                    style="@style/MovieDetailsMetaSeparator"
                    android:text="|"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/movie_duration"
                    style="@style/MovieDetailsMetaText"
                    tools:text="2 h 35" />

                <TextView
                    android:id="@+id/movie_badge_separator"
                    style="@style/MovieDetailsMetaSeparator"
                    android:text="|"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:id="@+id/movie_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/movie_rating_separator"
                    style="@style/MovieDetailsMetaSeparator"
                    android:text=""
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/rating_star"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/theme"
                    android:text="★"
                    android:textColor="#F6CD03"
                    android:textSize="15sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/movie_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:fontFamily="@font/theme"
                    android:textColor="#D8FFFFFF"
                    android:textSize="14sp"
                    tools:text="7.8" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/movie_actions"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/action_watch"
                    style="@style/MovieDetailsAction"
                    android:layout_width="134dp"
                    android:background="@drawable/movie_action_background"
                    android:nextFocusRight="@id/action_watched">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_movie_play" />

                    <TextView
                        android:id="@+id/action_watch_label"
                        style="@style/MovieDetailsActionLabel"
                        android:text="@string/details_action_watch_1" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_watched"
                    style="@style/MovieDetailsAction"
                    android:layout_width="159dp"
                    android:layout_marginLeft="16dp"
                    android:background="@drawable/movie_action_background"
                    android:nextFocusLeft="@id/action_watch"
                    android:nextFocusRight="@id/action_update">

                    <ImageView
                        android:id="@+id/action_watched_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_movie_check" />

                    <TextView
                        android:id="@+id/action_watched_label"
                        style="@style/MovieDetailsActionLabel"
                        tools:text="MARK AS WATCHED" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_update"
                    style="@style/MovieDetailsAction"
                    android:layout_width="132dp"
                    android:layout_marginLeft="16dp"
                    android:background="@drawable/movie_action_background"
                    android:nextFocusLeft="@id/action_watched">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_movie_info" />

                    <TextView
                        android:id="@+id/action_update_label"
                        style="@style/MovieDetailsActionLabel"
                        tools:text="UPDATE INFO" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/movie_genres"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/movie_tech_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/theme"
                android:maxLines="1"
                android:textColor="#C8FFFFFF"
                android:textSize="13sp"
                tools:text="H.265 • 4K HDR • French DTS-HD MA 5.1 • English TrueHD 7.1 Atmos • 71.5 GB" />

            <TextView
                android:id="@+id/movie_director"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/theme"
                android:textColor="#D8FFFFFF"
                android:textSize="14sp"
                tools:text="Director: Denis Villeneuve" />

            <TextView
                android:id="@+id/overview_label"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/movie_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/theme"
                android:lineSpacingExtra="2dp"
                android:maxLines="5"
                android:textColor="#C8FFFFFF"
                android:textSize="13sp"
                tools:text="L'histoire de Paul Atreides, jeune homme aussi doué que brillant, voué à connaître un destin hors du commun qui le dépasse totalement." />



            <TextView
                android:id="@+id/movie_filename"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
