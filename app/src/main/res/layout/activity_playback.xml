<?xml version="1.0" encoding="UTF-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:keepScreenOn="true"
	tools:ignore="RtlHardcoded">

	<androidx.media3.ui.PlayerView
		android:id="@+id/player_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		app:auto_show="false"
		app:animation_enabled="false"
		app:show_buffering="always"
		app:show_timeout="-1"
		app:controller_layout_id="@layout/playback_controller" />

	<RelativeLayout
		android:id="@+id/info_container_top"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/player_overlay"
		android:orientation="vertical"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:visibility="gone">

		<LinearLayout
			android:id="@+id/indicators"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentStart="true"
			android:layout_centerVertical="true"
			android:layout_gravity="bottom"
			android:layout_marginRight="4dp"
			android:orientation="horizontal">

			<ImageView
				android:id="@+id/indicator_4k"
				android:layout_width="24sp"
				android:layout_height="24sp"
				android:scaleType="fitCenter"
				android:src="@drawable/baseline_4k_white_18" />

			<ImageView
				android:id="@+id/indicator_hdr"
				android:layout_width="24sp"
				android:layout_height="24sp"
				android:scaleType="fitCenter"
				android:src="@drawable/baseline_hdr_white_18" />

		</LinearLayout>

		<TextView
			android:id="@+id/title_text_view"
			android:fontFamily="@font/theme"
			android:textFontWeight="@integer/weight_bold"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_centerVertical="true"
			android:layout_marginTop="16dp"
			android:layout_marginBottom="16dp"
			android:layout_toLeftOf="@id/controls_root"
			android:layout_toRightOf="@id/indicators"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="@color/player_text"
			android:textSize="@dimen/playback_title_size" />

		<LinearLayout
			android:id="@+id/controls_root"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentEnd="true"
			android:layout_centerVertical="true"
			android:orientation="horizontal" />

	</RelativeLayout>

	<RelativeLayout
		android:id="@+id/seek_root"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:background="@drawable/playback_controls_bg"
		android:padding="12dp"
		android:visibility="gone">

		<TextView
			android:id="@+id/seek_position"
			android:fontFamily="@font/theme"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerVertical="true"
			android:textColor="#fff"
			android:textSize="18sp" />

	</RelativeLayout>
    <Button
        android:id="@+id/next_episode"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/next_episode_background"
        android:fontFamily="@font/theme"
        android:paddingHorizontal="20dp"
        android:text="Next episode"
        android:textAllCaps="false"
        android:textColor="#141414"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
