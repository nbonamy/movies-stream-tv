<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/dialog_panel"
        android:layout_width="@dimen/tv_dialog_width"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/tv_dialog_panel_background"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="52dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/tv_dialog_accent" />

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:fontFamily="@font/theme"
            android:maxLines="2"
            android:textColor="@color/default_text_light"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Mediastation" />

        <ScrollView
            android:id="@+id/dialog_message_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/tv_dialog_action_background"
            android:fadeScrollbars="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/dialog_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/theme"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/tv_dialog_text_secondary"
                android:textSize="17sp"
                tools:text="Dialog message" />

        </ScrollView>

        <FrameLayout
            android:id="@+id/dialog_custom_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/dialog_action_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dialog_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
